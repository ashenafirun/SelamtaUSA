<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

		<record id="view_odoo_website_product_label_tree_view" model="ir.ui.view">
            <field name="name">odoo.website.product.label.tree.view</field>
            <field name="model">website.product.label</field>
            <field name="arch" type="xml">
               <list string="Website Product Label">
					 <field name="name"/>
					 <field name="position"/>
			    	 <field name="height"/>
			    	 <field name="width"/>
			    	 <field name="margin_top"/>
			    	 <field name="margin_bottom"/>
			    	 <field name="margin_left"/>
			    	 <field name="margin_right"/>
			    	 <field name="rotate_label" widget='radio'/>
			    	 <field name="rotate_value"/>
				</list>
		    </field>
        </record>



   <record id="view_odoo_website_product_label_form_view" model="ir.ui.view">
            <field name="name">odoo.website.product.label.form.view</field>
            <field name="model">website.product.label</field>
            <field name="arch" type="xml">
				<form string="Website Product Label" version="9.0">
						<sheet>
							<field name="image" widget="image" class="oe_avatar"/>
							<div class="oe_title">
							<label for="name" string="Product label"/>
								<h1><field name="name" style="width: 35% !important;"/></h1>
						   	</div>
						   	
						<group>
							<group string="Set Dimension">
								<field name="label_type"/>
								<field name="height"/>
								<field name="width"/>
								<field name="position"/>
							</group>
						</group>
					 	<group>
							<group string="Image Position">
								 <field name="margin_top" placeholder="eg. 7 or -7"/>
								 <field name="margin_bottom" placeholder="eg. 7 or -7"/>
								 <field name="margin_left" placeholder="eg. 7 or -7"/>
								 <field name="margin_right" placeholder="eg. 7 or -7"/>
								 <label for="rotate_label" string="Rotate Fonts"/>
								 <div class="oe_inline">
								 	<field name="rotate_label" widget='radio' nolabel="1"/>
								 	<button class="oe_stat_button" name="unset_img_rotation" string="Unset" type="object"
								 	invisible="rotate_label == False"/>
								 </div>
								 <field name="rotate_value" 
								 	required="rotate_label!=False"
								 	invisible="rotate_label==False"
								 	/>
							</group>

							<group string="Font Position"
							invisible="label_type=='defined'"
							 >
								<field name="font_color" placeholder='#ffffff or white or rgb(34,34,34)'/>
								<field name="font_size"/>
								 <field name="font_top" placeholder="eg. 5 or -5"/>
								 <field name="font_bottom" placeholder="eg. 5 or -5"/>
								 <field name="font_left" placeholder="eg. 5 or -5"/>
								 <field name="font_right" placeholder="eg. 5 or -5"/>
								 <label for="font_rotate_label" string="Rotate Fonts"/>
								 <div class="oe_inline">
								 	<field name="font_rotate_label" widget='radio' nolabel="1"/>
								 	<button class="oe_stat_button" name="unset_font_rotation" string="Unset" type="object"
								 	invisible="font_rotate_label==False"
								 	 />
								 </div>
								 <field name="font_rotate_value" 
								 	required="font_rotate_label!=False"
								 	invisible="font_rotate_label==False"
								 	/>
							</group>
						</group>
					 	
						</sheet>
				</form>
            </field>
        </record>
        
        <record model="ir.ui.view" id="odoo_website_product_label_kanban_view_bi">
            <field name="name">odoo.website.product.label.kanban.bi</field>
            <field name="model">website.product.label</field>
            <field name="arch" type="xml">
                <kanban class="o_res_partner_kanban" >
                    <field name="id"/>
                    <field name="image" widget="image" class="oe_left oe_avatar"/>
                    <field name="name"/>
                    <field name="position"/>
                    <field name="height"/>
					<field name="width"/>
					
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('website.product.label', 'image', record.id.raw_value)" alt="Label Image"/>
                                </div>
                                <div class="oe_kanban_details">
                                	<div class="o_kanban_record_top mb8">
	                                    <strong>
	                                        <field name="label_type" widget="label_selection" options="{'classes': { 'custom': 'warning', 'defined': 'success'}}"/>
	                                    </strong>
	                                </div>
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                    <ul>
                                        <li>Position: <field name="position"></field></li>
                                        <li>Height: <field name="height"></field></li>
                                        <li>Width: <field name="width"></field></li>
                                    </ul>
                                    <div name="tags"/>
                                </div>
                            </div>
                        </t>
                   </templates>
                    
                </kanban>
            </field>
        </record>
        
        

        
     	<record id="action_odoo_website_product_label_menu" model="ir.actions.act_window">
            <field name="name">Odoo Website Product Label</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">website.product.label</field>
            <field name="view_mode">kanban,list,form</field>
        </record>
		
		<menuitem id= "odoo_website_product_label_menu" parent= "sale.product_menu_catalog" name= "Website Product Label" action="action_odoo_website_product_label_menu" sequence="30" />
		
		
		 <record model="ir.ui.view" id="odoo_product_template_inherit_bi_form_view">
		        <field name="name">odoo.website.product.label.bi.form.view</field>
		        <field name="model">product.template</field>
		        <field name="inherit_id" ref="product.product_template_form_view"/>
		        <field name="arch" type="xml">
				    
				    <xpath expr="//page[@name='sales']/group[@name='sale']" position="after"> 
						 <group string="Website Product Label">
								<field name="label_type"/>
								<field name="lbl_title"
									invisible="label_type=='defined'"
								  />     
								<field name="select_label" readonly="0"/>  
								<field name="label_image" widget="image" class="oe_left oe_avatar"/> 
		                  </group>
					</xpath>
		        
		        </field>
         </record>	
    </data>
</odoo>
