    <template id="product_shop_page_price_hide_website_sale" inherit_id="website_sale.products_item">
        <xpath expr="//div[hasclass('product_price')]" position="attributes">
            <attribute name="t-if">
                not request.website.is_public_user()
            </attribute>
        </xpath>
    </template>

    <template id="product_cart_summary_price_hide_website_sale" inherit_id="website_sale.checkout_layout">
