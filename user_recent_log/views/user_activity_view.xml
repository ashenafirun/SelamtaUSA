<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- explicit list view definition -->    
    <record model="ir.ui.view" id="user_activity_view_tree">
        <field name="name">user.recent.log.tree</field>
        <field name="model">user.recent.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="last_visited_on"/>
                <field name="user_id"/>
                <button name="redirect_on_record" string="Redirect on Record" type="object" icon="fa-arrow-right"/>
            </list>
        </field>
    </record>
    <!-- explicit list view definition -->    
    <record model="ir.ui.view" id="user_activity_view_form">
        <field name="name">user.recent.log.form</field>
        <field name="model">user.recent.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="redirect_on_record" string="Redirect on Record" type="object" icon="fa-arrow-right"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="last_visited_on" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="User Activity">
                            <field name="activity" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
