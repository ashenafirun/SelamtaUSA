<?xml version="1.0" encoding="utf-8"?>
<openerp>
	<data>
		<record id="view_merge_internal_picking" model="ir.ui.view">
			<field name="name">Merge Picking</field>
			<field name="model">merge.internal.picking</field>
			<field name="arch" type="xml">
				<form string="Merge Picking">
					<p class="oe_grey">
						Picking will be created with all the selected picking.
					</p>
					<field name="internal_merge_with" invisible="1"/>
					<group invisible="internal_merge_with != 'different'">
<!--							attrs="{'invisible': [('internal_merge_with', '!=', 'different')]}">-->
						<group>
							<field name="is_internal_merge_different_Partner"/>
						</group>
						<group>
							<field name="partner_id" invisible="is_internal_merge_different_Partner == False"/>
<!--								   attrs="{'invisible': [('is_internal_merge_different_Partner', '=', False)]}"/>-->
						</group>
					</group>
					<field name="pickings_ids" nolabel="1" colspan="4" width="550" height="300" >
						<list>
							<field name="name"/>
							<field name="partner_id"/>
							<field name="origin"/>
							<field name="state"/>
						</list>
					</field>
					<footer>
						<button name="merge_internal_pickings" string="Merge Internal Pickings" type="object"
							class="btn-primary"/>
						<button string="Cancel" class="btn-default" special="cancel"/>
					</footer>
				</form>
			</field>
		</record>

		<record id="action_view_merge_internal_picking" model="ir.actions.act_window">
			<field name="name">Merge Internal Picking</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">merge.internal.picking</field>
			<field name="view_mode">form</field>
			<field name="target">new</field>
			<field name="binding_model_id" ref="model_stock_picking" />
		</record>

		<record id="inv_config_inherit_view1" model="ir.ui.view">
			<field name="name">inv.config.inherit</field>
			<field name="model">res.config.settings</field>
			<field name="inherit_id" ref="stock.res_config_settings_view_form" />
			<field name="arch" type="xml">
				<xpath expr="//block[@name='operations_setting_container']" position="after">
					<block title="Barcode" name="barcode_setting_container">
                            <setting id="process_operations_barcodes_temp" help="Process operations faster with barcodes" company_dependent="1" documentation="/applications/inventory_and_mrp/inventory/barcode/setup/software.html">
<!--                                <field name="module_stock_barcode" widget="upgrade_boolean"/>-->
								<field name="internal_merge_with" class="o_light_label" widget="radio"/>
                            </setting>
                        </block>
				</xpath>
<!--				<xpath expr="//div[@data-key='stock']/div[hasclass('o_settings_container')][1]" position="after" >-->
<!--					<h2>Select operation internal merging type</h2>-->
<!--					<div class="row mt16 o_settings_container">-->
<!--						<div class="col-12 col-lg-6 o_setting_box">-->
<!--							<div class="o_setting_right_pane">-->
<!--								<label for="internal_merge_with"/>-->
<!--								<div class="text-muted">-->
<!--									select operation internal merging type-->
<!--								</div>-->
<!--								<div class="content-group">-->
<!--									<div class="mt16">-->
<!--										<field name="internal_merge_with" class="o_light_label" widget="radio"/>-->
<!--									</div>-->
<!--								</div>-->
<!--							</div>-->
<!--						</div>-->
<!--					</div>-->
<!--				</xpath>-->
			</field>
		</record>
	</data>
</openerp>
