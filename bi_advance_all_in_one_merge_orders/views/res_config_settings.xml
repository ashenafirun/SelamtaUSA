<?xml version="1.0"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="view_website_sale_config_inherited_category">
            <field name="name">website.config.inherited.category</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='sale_product_catalog_settings']" position="after">
                    <h2>Website category/product
                        Configuration
                    </h2>
                    <div class="row mt16 o_settings_container" id="web_category_settings"
                         >
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="category_sync"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="category_sync"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="product_sync"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="product_sync"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="view_pos_config_inherited_category">
            <field name="name">pos.config.inherited.category</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_pricing_section']" position="after">
                    <h2>Merge category/product Configuration</h2>
                    <div class="row mt16 o_settings_container" id="merge_category_settings">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="sync_category"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="sync_category"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="sync_product"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="sync_product"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>