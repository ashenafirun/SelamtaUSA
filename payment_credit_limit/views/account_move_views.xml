<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_credit_hold" model="ir.ui.view">
        <field name="name">account.move.credit.hold.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="credit_approve_invoice"
                        string="Approve"
                        type="object"
                        groups="sales_team.group_sale_manager"
                        invisible="state != 'credit_hold' or state in ['approved', 'cancel']"/>
                <button name="cancel_invoice_on_cc"
                       string="Reject" type="object" groups="sales_team.group_sale_manager" invisible="state != 'credit_hold' or state in ['approved', 'cancel']"/>

            </xpath>

            <xpath expr="//page[@name='invoice_tab']" position="after">
                <page string="Approval History"
                        invisible="inv_approval_history_ids == []" >
                    <field name="inv_approval_history_ids" readonly="1">
                        <list string="Approval History">
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="approved_amount"/>
                            <field name="reason"/>
                            <field name="status"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
