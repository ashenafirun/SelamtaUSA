<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="view_order_form_inherit">
        <field name="name">sale.order.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_totals']" position="after">
                <group class="oe_subtotal_footer text-danger" colspan="3" name="approved_amount">
                    <label class="oe_subtotal_footer text-danger" for="approved_amount" invisible="state not in ['approved']"/>
                    <field name="approved_amount" class="oe_subtotal_footer text-danger" nolabel="1" readonly="1" invisible="state not in ['approved']"/>
               </group>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">state in ['cancel', 'sale', 'credit_hold']</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">state == 'credit_hold'</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="sale_view_inherit123">
        <field name="name">sale.order.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_crm.sale_view_inherit123"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_lock" type="object" string="Set to Done"
                        invisible="state in ['credit_hold', 'approved', 'done', 'cancel']"
                        help="If a sale order is done, you cannot modify it manually anymore. However, you will still be able to invoice or deliver. This is used to freeze the sale order."/>
                <button name="delivery_order" type="object" string="Confirm" invisible="(state not in ['sale', 'approved'] or already_delivery_generated) and (picking_ids or delivery_state != 'cancel')"/>
                <button name="credit_approve" string="Approve" type="object"  groups="sales_team.group_sale_manager" invisible="state != 'credit_hold' or state in ['approved', 'cancel']"/>
                <button name="cancel_order_on_cc" string="Reject" type="object" groups="sales_team.group_sale_manager" invisible="state != 'credit_hold' or state in ['approved', 'cancel']"/>
            </xpath>
            <field name="payment_term_id" position="after">
                <field name="delivery_state" invisible="1"/>
                <field name="already_delivery_generated" invisible="1"/>
            </field>
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Approval History" name="approval_history">
                    <field name="picking_ids" invisible="1"/>
                    <field name="approval_history_ids" nolabel="1" readonly="1">
                        <form string="Approval History">
                            <group colspan="4" col="4">
                                <field name="user_id"/>
                                <field name="status"/>
                                <field name="approved_amount"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="reason"/>
                            </group>
                        </form>
                        <list string="Approval History">
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="approved_amount"/>
                            <field name="reason"/>
                            <field name="status"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="sale_view_search_inherit">
        <field name="name">sale.order.search.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="before">
                <filter string="CC Hold Orders" domain="[('state', '=', 'credit_hold')]" name="cc_hold_orders_filter"/>
                <separator/>
            </filter>
        </field>
    </record>
</odoo>
