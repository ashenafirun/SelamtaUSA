<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Selamta footer: replaces the theme footer content (#footer) and the copyright line.
        Priority 99 so it applies after theme_alan's footer and the old copyright edit.
    -->
    <template id="footer" inherit_id="website.layout" name="Selamta Footer" priority="99">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo sel-footer" t-ignore="true" t-if="not no_footer">
                <section class="sel-footer-main">
                    <div class="container">
                        <div class="row sel-footer-grid">
                            <div class="col-12 col-lg-5 sel-footer-brand">
                                <span class="sel-footer-logo"><img src="/web/image/website/1/logo" width="76" height="56" alt="Selamta Import + Distribute"/></span>
                                <p>Your trusted wholesale partner for authentic Ethiopian imports. Supplying quality you can trust, service you can count on.</p>
                                <div class="sel-footer-social">
                                    <a href="https://www.facebook.com/pages/category/Food-Wholesaler/Selamta-Import-and-Export-206766002863808/" target="_blank" rel="noopener" aria-label="Selamta on Facebook"><i class="fa fa-facebook" role="img" aria-hidden="true"/></a>
                                    <a href="https://www.instagram.com/selamtausa/?hl=en" target="_blank" rel="noopener" aria-label="Selamta on Instagram"><i class="fa fa-instagram" role="img" aria-hidden="true"/></a>
                                </div>
                            </div>
                            <div class="col-6 col-lg-2 sel-footer-col">
                                <h5>Company</h5>
                                <ul class="list-unstyled">
                                    <li><a href="/about-us-1">About us</a></li>
                                    <li><a href="/contactus">Contact us</a></li>
                                    <li><a href="/new-customer-registration">New customer registration</a></li>
                                    <li><a href="/my">My account</a></li>
                                </ul>
                            </div>
                            <div class="col-6 col-lg-2 sel-footer-col">
                                <h5>Help</h5>
                                <ul class="list-unstyled">
                                    <li><a href="/shipping-returns">Shipping &amp; Returns</a></li>
                                    <li><a href="/terms-and-conditions">Terms &amp; Conditions</a></li>
                                    <li><a href="/privacy-policy">Privacy Policy</a></li>
                                </ul>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3 sel-footer-col">
                                <h5>Visit or call</h5>
                                <ul class="list-unstyled">
                                    <li>5335 Dividend Dr #C<br/>Decatur, GA 30035</li>
                                    <li><a href="tel:+14047504162">(404) 750-4162</a></li>
                                    <li><a href="mailto:contact@selamtausa.com">contact@selamtausa.com</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
        <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
            <span class="o_footer_copyright_name me-2">Copyright © <t t-out="datetime.date.today().year"/> Selamta LLC. All rights reserved.</span>
        </xpath>
    </template>

</odoo>
