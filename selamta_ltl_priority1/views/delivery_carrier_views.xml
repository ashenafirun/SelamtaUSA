<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_priority1" model="ir.ui.view">
        <field name="name">delivery.carrier.form.priority1</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Priority1" name="priority1" invisible="delivery_type != 'priority1'">
                    <div class="alert alert-info" role="alert" invisible="p1_book_shipments">
                        Quotes and tracking only. Choosing a Priority1 quote in the rate shop saves it; book the
                        load on Priority1's website and type the PRO. Turning on "Dispatch through the API"
                        books real pickups.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not p1_book_shipments">
                        Dispatch is on: choosing a Priority1 quote in the rate shop books a real pickup.
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="p1_api_key" password="True" groups="base.group_system"/>
                            <button name="action_p1_test_connection" type="object" string="Test key (sample quotes)"
                                    class="btn-secondary" groups="base.group_system" colspan="2"/>
                            <field name="p1_max_quotes"/>
                        </group>
                        <group string="Booking">
                            <field name="p1_book_shipments"/>
                            <field name="p1_contact_name"/>
                            <field name="p1_contact_phone"/>
                            <field name="p1_contact_email"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_ltl_shipment_form_priority1" model="ir.ui.view">
        <field name="name">selamta.ltl.shipment.form.priority1</field>
        <field name="model">selamta.ltl.shipment</field>
        <field name="inherit_id" ref="selamta_ltl.view_ltl_shipment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pickup_number']" position="after">
                <field name="p1_carrier_name" invisible="not p1_carrier_name"/>
                <field name="p1_carrier_scac" invisible="not p1_carrier_scac"/>
                <field name="p1_shipment_id" invisible="not p1_shipment_id"/>
            </xpath>
        </field>
    </record>
</odoo>
