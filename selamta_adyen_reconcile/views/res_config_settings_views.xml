<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_adyen_rec" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.adyen.reconcile</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Adyen settlements" name="selamta_adyen_reconcile">
                    <setting string="Reconcile Adyen payouts automatically"
                             help="Batch each Adyen settlement report and book its payout when the bank line arrives.">
                        <field name="adyen_rec_auto_process"/>
                    </setting>
                    <setting string="Accounts" help="Where payouts, Adyen fees and the Adyen deposit are booked.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="adyen_rec_journal_id" class="col-lg-4 o_light_label"/>
                                <field name="adyen_rec_journal_id"/>
                            </div>
                            <div class="row">
                                <label for="adyen_rec_fee_account_id" class="col-lg-4 o_light_label"/>
                                <field name="adyen_rec_fee_account_id"/>
                            </div>
                            <div class="row">
                                <label for="adyen_rec_deposit_account_id" class="col-lg-4 o_light_label"/>
                                <field name="adyen_rec_deposit_account_id"/>
                            </div>
                            <div class="row">
                                <label for="adyen_rec_review_user_id" class="col-lg-4 o_light_label"/>
                                <field name="adyen_rec_review_user_id"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Chargebacks" help="Booked, emailed to the customer and posted to this channel automatically. The fee is invoiced from the second chargeback incident in 12 months; ACH is turned off from the third.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="adyen_rec_dispute_channel_id" class="col-lg-4 o_light_label"/>
                                <field name="adyen_rec_dispute_channel_id"/>
                            </div>
                            <div class="row">
                                <label for="adyen_rec_cb_fee_product_id" class="col-lg-4 o_light_label"/>
                                <field name="adyen_rec_cb_fee_product_id"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Adyen connection" groups="base.group_system"
                             help="Report user API key, and the HMAC key of the Report available webhook pointed at /selamta_adyen/report_webhook.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="adyen_rec_api_key" class="col-lg-4 o_light_label"/>
                                <field name="adyen_rec_api_key" password="True"/>
                            </div>
                            <div class="row">
                                <label for="adyen_rec_hmac_key" class="col-lg-4 o_light_label"/>
                                <field name="adyen_rec_hmac_key" password="True"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
