<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="adv_credit_limit_payment"
              name="Customer Credit Limit"
              inherit_id="website_sale.payment">

        <xpath expr="//div[@id='address_on_payment']" position="after">
            <div class="list-group mt-3">

                <!-- Pay Now -->
                <label class="o_payment_option o_outline list-group-item mb-2"
                    t-if="not show_past_due_option" >
                    <div class="form-check">
                        <input type="radio"
                               name="payment_option"
                               value="1"
                               id="pay_now"
                               class="form-check-input js_confirm_style"
                               t-att-checked="payment_option == 1 or not payment_option"/>
                        <span class="o_payment_option_label">
                            Pay Now
                        </span>
                    </div>
                </label>

                <!-- Past Due Option -->
                  <label class="o_payment_option o_outline list-group-item"
                   t-if="show_past_due_option">
                   <div id="adv_payment_method_hide"
                        t-att-data-show-past-due="1 if show_past_due_option else 0" >
                    <div   class="form-check">
                        <input type="radio"
                               name="payment_option"
                               value="3"
                               id="past_due_balance"
                               class="form-check-input js_confirm_style"
                               t-att-checked="payment_option == 3"/>

                        <span class="o_payment_option_label">
                           Please pay your Past Due Balance
                            <t t-out="past_due_amount"
                               t-options="{
                                   'widget': 'monetary',
                                   'display_currency': website.currency_id
                               }"/>
                        </span>
                    </div>
                </div>
                </label>

                <!-- Note for Past Due Customer -->
                <div class="card-body"
                    t-if="show_past_due_option"
                    style="padding:6px 10px;">
                    <div class="alert alert-danger"
                         style="padding:6px 10px;
                                margin-bottom:4px;
                                font-size:16px;
                                line-height:2.5;">
                        <span>Please settle the outstanding balance of </span>
                        <t t-out="past_due_amount"
                           t-options="{
                               'widget': 'monetary',
                               'display_currency': website.currency_id
                           }"/>
                        <span>to proceed further.</span>
                    </div>
                </div>

               <!--  <label class="o_payment_option o_outline list-group-item"
                   t-if="show_selected_past_due_option">
                <div class="form-check">
                    <input type="radio"
                           name="payment_option"
                           value="3"
                           id="past_due_balance"
                           class="form-check-input js_confirm_style"
                           t-att-checked="payment_option == 3"/>

                    <span class="o_payment_option_label">
                        Pay Past Due Balance –
                        <t t-out="selected_past_due_total"
                           t-options="{
                               'widget': 'monetary',
                               'display_currency': website.currency_id
                           }"/>
                    </span>
                </div>
            </label>
 -->
                <!-- Credit Limit -->
                <label class="o_payment_option o_outline list-group-item mt-3"
                       t-if="available_balance > 0 and not credit_balance_exceeded and not show_past_due_option">
                    <div class="form-check">
                        <input type="radio"
                               name="payment_option"
                               value="2"
                               id="credit_limit"
                               class="form-check-input js_confirm_style"
                               t-att-checked="payment_option == 2"/>
                        <span class="o_payment_option_label">
                            Use Credit Limit and Confirm Order
                            (Available Balance:
                            <t t-out="available_balance"
                               t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </span>
                    </div>
                </label>

                <!-- Credit exceeded message -->
                <div class="card-body"
                    t-if="show_credit_alert and not show_past_due_option and available_balance"
                    style="padding:6px 10px;">
                    <div class="alert alert-danger"
                         style="padding:6px 10px;
                                margin-bottom:4px;
                                font-size:16px;
                                line-height:2.5;">
                        <span>Your credit balance is </span>
                        <t t-out="available_balance"
                           t-options="{
                               'widget': 'monetary',
                               'display_currency': website.currency_id
                           }"/>
                        <span>. Credit limit is exceeded.</span>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Hide payment providers when credit selected -->
        <xpath expr="//div[@id='payment_method']" position="attributes">
            <attribute name="t-att-style">
                "display:none;" if payment_option == 2 else ""
            </attribute>
        </xpath>

        <!-- Hide default payment button when credit selected -->
        <xpath expr="//div[@name='website_sale_non_free_cart']" position="attributes">
            <attribute name="t-att-style">
                "display:none;" if payment_option == 2 else ""
            </attribute>
        </xpath>

    </template>

    <template id="adv_confirm_order_button" inherit_id="website_sale.navigation_buttons">
        <xpath expr="//div[@name='o_website_sale_free_cart']" position="after">
            <div t-if="payment_option == 2 and available_balance > 0 and not credit_balance_exceeded"
                 class="d-flex flex-column mb-5 mb-lg-0 pt-4">
                <h6 class="alert alert-info">
                    You are paying using your Credit Limit.
                </h6>
                <form action="/sale/confirm/order" method="post">
                    <input type="hidden"
                           name="csrf_token"
                           t-att-value="request.csrf_token()"/>

                    <button type="submit"
                            class="btn btn-primary w-100 px-5">
                        Confirm Order
                    </button>
                </form>
            </div>
        </xpath>

        <!-- Hide Pay Now button   'd-none' if payment_option == 2 else '' -->
        <xpath expr="//t[@t-call='payment.submit_button']/.." position="attributes">
            <attribute name="t-att-class">

                'd-none' if payment_option in (2, 3) else ''

            </attribute>
        </xpath>

    </template>

    <template id="adv_credit_website_layout">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div>
                    <h3>Thank you for your order.</h3>
                    <p>
                        Order
                        <strong t-out="order.name"/>
                        has been confirmed successfully.
                    </p>
                    <p>
                        Total Amount:
                        <strong t-out="order.amount_total"
                                t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                    </p>
                    <a href="/shop" class="btn btn-primary mt-3">
                        Continue Shopping
                    </a>

                </div>
            </div>
        </t>
    </template>

    <template id="payment_form_inherit_outstanding_invoice_button"
          inherit_id="website_sale.payment">
            <xpath expr="//input[@id='credit_limit']/ancestor::label" position="after">
                <t t-if="payment_option == 3 and show_past_due_option">
                    <div class="mt-3 d-flex justify-content-end">
                        <a href="/my/invoices?filterby=overdue_invoices"
                                   class="btn btn-primary px-3 py-1 shadow-sm d-inline-flex align-items-center">
                            <span class="me-2">Pay Outstanding Invoices</span>
                            <i class="fa fa-arrow-right"></i>
                        </a>
                    </div>
                </t>
        </xpath>
    </template>

    <template id="hide_submit_button_for_past_due"
              inherit_id="payment.submit_button">
        <xpath expr="//button[@name='o_payment_submit_button']" position="attributes">
            <attribute name="t-attf-class">
                btn btn-primary w-100 w-md-auto ms-auto px-5 #{'d-none' if payment_option == 3 else ''}
            </attribute>
        </xpath>
    </template>

    <template id="use_credit_limit_payment_method"
              inherit_id="payment.method_form">
        <xpath expr="//div[@name='o_payment_tokenize_container']"
           position="after">
            <div t-if="allow_credit and credit_balance_exceeded"
                 class="o-checkbox form-check m-0 ms-3 o_payment_credit_limit_container"
                 onclick="event.stopPropagation();">
                <label>
                    <input name="o_payment_use_credit_limit_checkbox"
                           type="checkbox"
                           class="form-check-input"
                    />
                    <small class="text-600">Use Credit Limit</small>
                </label>
            </div>
        </xpath>

        <xpath expr="//div[@name='o_payment_inline_form']"
           position="inside">
            <div class="js_credit_breakdown mt-2 small"
                 style="display:none;">
                <div class="alert alert-info py-2 px-3 mb-1"
                     style="font-size:13px; line-height:1.8;">
                    <div>
                        <i class="fa fa-info-circle me-1"/>
                        <strong>Credit Limit will be applied:</strong>
                    </div>
                    <div class="ms-3">
                        Credit to be used:
                        <strong class="js_credit_applied_amount">
                            <t t-out="available_credit_to_use or 0"
                               t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </strong>
                    </div>
                    <div class="ms-3">
                        Amount to pay via payment provider:
                        <strong class="js_remaining_pay_amount">
                            <t t-out="remaining_amount or 0"
                               t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </strong>

                        <span class="js_charge_note"
                            style="display:none;">
                            ,Charges will be applied on this amount
                        </span>
                    </div>
                    <div class="ms-3">
                        Resulted Due amount is:
                        <strong class="js_credit_applied_amount">
                            <t t-out="available_credit_to_use or 0"
                               t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </strong>
                    </div>
                </div>
            </div>
        </xpath>

    </template>



    <!-- Add credit data attributes to the payment form element -->
    <template id="payment_form_credit_data"
              inherit_id="payment.form">
        <xpath expr="//form[@id='o_payment_form']" position="attributes">
            <attribute name="t-att-data-available-credit">available_credit_to_use if allow_credit else 0</attribute>
            <attribute name="t-att-data-remaining-amount">remaining_amount if allow_credit else 0</attribute>
            <attribute name="t-att-data-order-total">order.amount_total if order else amount</attribute>
        </xpath>
    </template>

    <!-- Add Use Credit Limit checkbox inside token forms -->
    <template id="use_credit_limit_payment_token"
              inherit_id="payment.token_form">

        <xpath expr="//input[@name='o_payment_radio']" position="attributes">
            <attribute name="t-att-data-payment-method-code">
                token_sudo.payment_method_id.code
            </attribute>
        </xpath>
        <xpath expr="//div[@class='d-flex gap-3 align-items-start align-items-md-center']"
               position="after">
            <div t-if="allow_credit and credit_balance_exceeded"
                 class="o-checkbox form-check m-0 ms-3 mt-2 o_payment_credit_limit_container"
                 onclick="event.stopPropagation();">
                <label>
                    <input name="o_payment_use_credit_limit_checkbox"
                           type="checkbox"
                           class="form-check-input"/>
                    <small class="text-600">Use Credit Limit</small>
                </label>
            </div>
            <div t-if="allow_credit and credit_balance_exceeded"
                 class="js_credit_breakdown mt-2 small"
                 style="display:none;">
                <div class="alert alert-info py-2 px-3 mb-1"
                     style="font-size:13px; line-height:1.8;">
                    <div>
                        <i class="fa fa-info-circle me-1"/>
                        <strong>Credit Limit will be applied:</strong>
                    </div>
                    <div class="ms-3">
                        Credit to be used:
                        <strong class="js_credit_applied_amount">
                            <t t-out="available_credit_to_use or 0"
                               t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </strong>
                    </div>
                    <div class="ms-3">
                        Amount to pay via payment provider:
                        <strong class="js_remaining_pay_amount">
                            <t t-out="remaining_amount or 0"
                               t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </strong>
                        <span class="js_charge_note"
                            style="display:none;">
                            ,Charges will be applied on this amount
                        </span>
                    </div>
                     <div class="ms-3">
                        Resulted Due amount is:
                        <strong class="js_credit_applied_amount">
                            <t t-out="available_credit_to_use or 0"
                               t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </strong>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="adv_payment_confirmation_status_fix"
          inherit_id="website_sale.payment_confirmation_status">

        <xpath expr="//div[contains(@t-attf-class, 'card')]" position="attributes">
            <attribute name="t-attf-class">card #{
                (tx_sudo.state == 'pending' and 'bg-info') or
                (tx_sudo.state == 'done'
                    and (order.currency_id.compare_amounts(tx_sudo.amount, order.amount_total) >= 0
                         or (order.used_credit_amount
                             and order.currency_id.compare_amounts(tx_sudo.amount + order.used_credit_amount, order.amount_total) >= 0))
                    and 'alert-success') or
                (tx_sudo.state == 'done'
                    and order.currency_id.compare_amounts(tx_sudo.amount, order.amount_total) &lt; 0
                    and not (order.used_credit_amount
                             and order.currency_id.compare_amounts(tx_sudo.amount + order.used_credit_amount, order.amount_total) >= 0)
                    and 'bg-warning') or
                (tx_sudo.state == 'authorized' and 'alert-success') or
                'bg-danger'}</attribute>
        </xpath>

        <xpath expr="//span[contains(text(), 'Unfortunately your order can not be confirmed')]/.."
           position="replace">
            <t t-if="tx_sudo.state == 'done'
                     and order.currency_id.compare_amounts(tx_sudo.amount, order.amount_total) &lt; 0
                     and not (order.used_credit_amount
                              and order.currency_id.compare_amounts(tx_sudo.amount + order.used_credit_amount, order.amount_total) >= 0)">
                <span>Unfortunately your order can not be confirmed as the amount of your
                      payment does not match the amount of your cart.
                      Please contact the responsible of the shop for more information.</span>
            </t>
        </xpath>
    </template>

    <template id="adv_payment_status_amount_fix"
              inherit_id="payment.payment_status">
        <xpath expr="//t[@t-call='payment.summary_item'][t[@t-set='label' and text()='Amount']]"
            position="replace">
            <t t-call="payment.summary_item">
                <t t-set="name" t-value="'amount'"/>
                <t t-set="label">Amount</t>
                <!-- <t t-set="value" t-value="
                    (tx.amount + tx.sale_order_ids[:1].used_credit_amount)
                    if tx.sale_order_ids and tx.sale_order_ids[:1].used_credit_amount
                    else tx.amount
                "/> -->
                <t t-set="value" t-value="
                    (tx.amount or 0)
                    + (tx.sale_order_ids[:1].used_credit_amount or 0)
                    + (tx.fees if tx.provider_code == 'adyen' else 0)
                "/>
                <t t-set="options"
                   t-value="{
                       'widget': 'monetary',
                       'display_currency': tx.currency_id,
                   }"
                />
            </t>
        </xpath>
    </template>

    <template id="adv_confirmation_amount_fix"
              inherit_id="website_sale.confirmation">
        <xpath expr="//strong[@t-field='tx_sudo.amount']" position="replace">
            <strong t-if="tx_sudo.sale_order_ids[:1].used_credit_amount"
                    t-out="tx_sudo.amount + tx_sudo.sale_order_ids[:1].used_credit_amount"
                    t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
            <strong t-else=""
                    t-field="tx_sudo.amount"
                    t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
        </xpath>
    </template>

</odoo>
