<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="view_order_form_credit_limit" model="ir.ui.view">
	    <field name="name">sale.order.form.credit.limit</field>
	    <field name="model">sale.order</field>
	    <field name="inherit_id" ref="sale.view_order_form"/>
	    <field name="arch" type="xml">
	        <xpath expr="//field[@name='payment_term_id']" position="after">
	            <field name="is_credit_limit_used" invisible="1"/>
	            <field name="used_credit_amount"
	                   widget="monetary"
	                   optional="show"
	                   invisible="not is_credit_limit_used"
	                   readonly="1"
	                   />
	        </xpath>
	    </field>
	</record>
</odoo>