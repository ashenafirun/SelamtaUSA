<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sale_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.sale.view.form.past.due.notification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='catalog_setting_container']" position="after">
                <block title="Past Due Notification" name="past_due_notification_container">
                    <setting
                        id="past_due_notification_settings"
                        string="Past Due Notification on E-Commerce"
                        help="Show customer's past due invoice balance during website checkout."
                    >
                        <field name="enable_past_due_notification"/>
                        <div class="content-group" invisible="not enable_past_due_notification">
                            <div class="mt8 text-muted">
                                Portal customers will be notified of their outstanding past due balance during checkout and can choose to pay it before confirming the order.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
