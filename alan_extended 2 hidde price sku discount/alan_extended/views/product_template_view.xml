<odoo>

    <record id="product_template_discount_offer_only_form_view" model="ir.ui.view">
        <field name="name">product.template.only.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_ok']" position="before">
                <group>
                    <field name="sku_code"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Discount Offer">
                    <field name="discount_offer" widget="html" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
