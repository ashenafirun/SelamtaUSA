<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_forecast_seasonality_list" model="ir.ui.view">
            <field name="name">forecast.seasonality.list</field>
            <field name="model">forecast.seasonality</field>
            <field name="arch" type="xml">
                <list>
                    <field name="seasonality_name"/>
                </list>
            </field>
        </record>

        <record id="view_forecast_seasonality_form" model="ir.ui.view">
            <field name="name">forecast.seasonality.form</field>
            <field name="model">forecast.seasonality</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="seasonality_name" required="1"/>
                        </group>
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="month"/>
                                <field name="factor"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_forecast_seasonality" model="ir.actions.act_window">
            <field name="name">Forecast Seasonality</field>
            <field name="res_model">forecast.seasonality</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_forecast_seasonality"
                  name="Forecast Seasonality"
                  parent="forecasting_auto_replenishment.menu_forecast_root"
                  action="action_forecast_seasonality"
                  sequence="3"/>
    </data>
</odoo>