<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_split_packaging" model="ir.ui.view">
        <field name="name">stock.picking.form.split.packaging</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Toggle button in header next to Validate -->
            <xpath expr="//button[@name='button_validate']" position="before">
                <button name="action_toggle_lot_picked"
                        type="object"
                        class="btn-secondary"
                        invisible="state in ('done', 'cancel')"
                        string="📋 Mark Lot Picked"
                />
            </xpath>

            <!-- Toggle switch inside Operations tab -->
            <xpath expr="//page[@name='operations']" position="inside">
                <group invisible="state in ('done', 'cancel')">
                    <field name="mark_lot_lines_picked"
                           widget="boolean_toggle"
                           string="Mark Lot Products as Picked (enables ▼ in Barcode app)"
                    />
                </group>
            </xpath>

        </field>
    </record>
</odoo>
