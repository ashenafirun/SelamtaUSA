    <template id="product_shop_page_cart_button_hide_website_sale" inherit_id="website_sale.products_item">
        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="attributes">
            <attribute name="t-att-data-hide">
                request.website.is_public_user()
            </attribute>
        </xpath>
    </template>

    <template id="product_detail_page_cart_button_hide_website_sale" inherit_id="website_sale.product">
        <xpath expr="//a[@id='add_to_cart']" position="attributes">
            <attribute name="t-att-data-hide">
                request.website.is_public_user()
            </attribute>
        </xpath>
        <xpath expr="//div[hasclass('css_quantity')]" position="attributes">
            <attribute name="t-att-data-hide">
                request.website.is_public_user()
            </attribute>
        </xpath>
    </template>
    <template id="as_quick_view_detail_price_hide_website_sale" inherit_id="atharva_theme_base.as_quick_view">
        <xpath expr="//p[hasclass('css_not_available_msg')]" position="after">
            <div class="text-primary" t-if="request.website.is_public_user()">
                LogIn To See Prices
            </div>
        </xpath>
        <xpath expr="//a[@id='qk_add_to_cart']" position="replace">
            <a t-if="not request.website.is_public_user()" role="button" id="qk_add_to_cart" t-att-disabled="'disabled' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 1) else None"
               t-attf-class="btn btn-primary as-btn qk_check_product #{'disabled out_of_stock' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 1) else ''}" href="#"><i class="fa fa-shopping-cart mr-2"/><span>ADD TO CART</span></a>
        </xpath>
        <xpath expr="//div[hasclass('css_quantity')]" position="replace">
            <div t-if="not request.website.is_public_user()" class="css_quantity input-group d-inline-flex mr-2 my-1 align-middle" contenteditable="false">
                <div class="input-group-prepend">
                    <a t-attf-href="#" t-att-disabled="'disabled' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 1) else None"
                       t-attf-class="btn btn-primary js_add_cart_json #{'disabled out_of_stock' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 1) else ''}" aria-label="Remove one" title="Remove one">
                        <i class="fa fa-minus"></i>
                    </a>
                </div>
                <input type="text" t-att-disabled="'disabled' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 1) else None"
                       t-attf-class="form-control quantity #{'disabled out_of_stock' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 1) else ''}" data-min="1" name="add_qty" t-att-value="add_qty or 1"/>
                <div class="input-group-append">
                    <a t-attf-href="#" t-att-disabled="'disabled' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 1) else None"
                       t-attf-class="btn btn-primary float_left js_add_cart_json #{'disabled out_of_stock' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 1) else ''}" aria-label="Add one" title="Add one">
                        <i class="fa fa-plus"></i>
                    </a>
                </div>
            </div>
        </xpath>
    </template>

     <template id="sh_products_item_inherit_qty" inherit_id="website_sale.products_item" active="False" customize_show="True" name="Select Cart Quantity">
        <xpath expr="//div[hasclass('product_price')]" position="after">
            <span t-if="not request.website.is_public_user()"
                  class="css_quantity input-group mb8 mt8 align-items-center" contenteditable="false">
                <div class="input-group-prepend">
                    <a t-attf-href="#" class="btn btn-primary js_add_cart_json" aria-label="Remove one" title="Remove one" style="padding: 0px 5px; height: 23px;">
                        <i class="fa fa-minus"></i>
                    </a>
                </div>
               <input type="text" class="form-control quantity"
	            	id="input_qty_list"
                      style="height: 100%;"
	            	t-att-data-min="1"
	            	t-att-data-setqty="1"
	            	name="add_qty"
	            	t-att-value="1"/>
                <div class="input-group-append">
                    <a t-attf-href="#" class="btn btn-primary float_left js_add_cart_json" aria-label="Add one" title="Add one" style="padding: 0px 5px; height: 23px;">
                        <i class="fa fa-plus"></i>
                    </a>
                </div>
                <span>
                    <t t-if="len(product.product_variant_ids) == 1">
                        <button type="button" role="button" t-att-disabled="'disabled' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 1) else None"
                                t-attf-class="btn btn-primary sh_add_cart_list #{'disabled out_of_stock' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 1) else ''}" title="Shopping cart" t-att-data-product-product-id="product.product_variant_ids[0].id if product.product_variant_ids else '0'">
                            Add
                        </button>
                    </t>
                    <t t-if="len(product.product_variant_ids) &gt; 1">
                        <button href="#" role="button" t-att-disabled="'disabled' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 1) else None"
                                t-attf-class="btn btn-secondary quick_add_pop_view_list quick-view-a not_product_page a-submit sh_add_cart_list #{'disabled out_of_stock' if (not product.sudo().allow_out_of_stock_order and product.sudo().qty_available &lt; 0) else ''}" aria-label="Shopping cart" title="Shopping cart"
                                t-att-data-product-product-id="product.product_variant_ids[0].id if product.product_variant_ids else '0'" t-att-data-id="product.id">
                            Add
                        </button>
                    </t>
                </span>
            </span>
            <div class="text-primary" t-if="request.website.is_public_user()">
                LogIn To See Prices
            </div>
        </xpath>
    </template>

</odoo>
