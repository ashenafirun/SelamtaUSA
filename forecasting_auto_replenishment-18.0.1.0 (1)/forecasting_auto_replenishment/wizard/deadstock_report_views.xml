<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view for Deadstock Report -->
    <record id="view_forecast_deadstock_wizard_list" model="ir.ui.view">
        <field name="name">forecast.deadstock.wizard.list</field>
        <field name="model">forecast.deadstock.wizard</field>
        <field name="arch" type="xml">
            <list string="Deadstock Report" decoration-danger="days_since_movement >= 120"
                  decoration-warning="days_since_movement >= 60 and days_since_movement &lt; 120"
                  decoration-info="days_since_movement >= 30 and days_since_movement &lt; 60"
                  decoration-muted="days_since_movement &lt; 30">
                <field name="product" string="Product"/>
                <field name="warehouse" string="Warehouse"/>
                <field name="current_stock" string="Current Stock" sum="Total"/>
                <field name="last_movement" string="Last Movement"/>
                <field name="days_since_movement" string="Days Since Movement" sum="Avg"/>
                <field name="status" string="Status" widget="badge" decoration-danger="status=='Deadstock'"
                       decoration-warning="status=='Very Slow Moving'"
                       decoration-info="status=='Slow Moving'"/>
            </list>
        </field>
    </record>

    <!-- Action for Deadstock Report List View -->
    <record id="action_deadstock_report_list" model="ir.actions.act_window">
        <field name="name">Deadstock Report</field>
        <field name="res_model">forecast.deadstock.wizard</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_forecast_deadstock_wizard_list"/>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No deadstock data found</p>
            <p>Products with no movement appear here when they exceed the inactivity threshold.</p>
        </field>
    </record>

    <!-- Button to generate PDF from list view -->
    <record id="action_deadstock_report_pdf" model="ir.actions.act_window">
        <field name="name">Print PDF</field>
        <field name="res_model">forecast.deadstock.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="forecasting_auto_replenishment.model_forecast_deadstock_wizard"/>
        <field name="binding_type">action</field>
    </record>

    <menuitem id="menu_forecast_reports_root"
                  name="Reports"
                  parent="forecasting_auto_replenishment.menu_forecast_root"
                  sequence="4"/>

    <menuitem id="menu_deadstock_report"
              name="Deadstock Report"
              parent="forecasting_auto_replenishment.menu_forecast_reports_root"
              action="action_deadstock_report_list"
              sequence="1"/>

</odoo>