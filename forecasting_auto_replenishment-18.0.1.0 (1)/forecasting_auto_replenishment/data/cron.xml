<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
         <record id="auto_generate_forecast" model="ir.cron">
            <field name="name">Product Forecast</field>
            <field name="model_id" ref="model_forecast_rule"/>
            <field name="state">code</field>
            <field name="code">model.action_generate_forecast()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="auto_create_transfer" model="ir.cron">
            <field name="name">Product Transfers</field>
            <field name="model_id" ref="model_forecast_rule"/>
            <field name="state">code</field>
            <field name="code">model.create_transfer()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

    </data>
</odoo>
