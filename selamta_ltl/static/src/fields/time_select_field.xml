<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="selamta_ltl.TimeSelectField">
        <t t-if="props.readonly">
            <span t-esc="formattedValue"/>
        </t>
        <t t-else="">
            <select class="o_input pe-3 o_selamta_time_select"
                    t-att-id="props.id"
                    t-on-change="onChange"
                    t-on-click.stop="() =&gt; {}">
                <t t-foreach="options" t-as="option" t-key="option.minutes">
                    <option t-att-value="option.minutes"
                            t-att-selected="option.minutes === currentMinutes"
                            t-esc="option.label"/>
                </t>
            </select>
        </t>
    </t>

</templates>
