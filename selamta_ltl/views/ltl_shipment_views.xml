<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ltl_shipment_form" model="ir.ui.view">
        <field name="name">selamta.ltl.shipment.form</field>
        <field name="model">selamta.ltl.shipment</field>
        <field name="arch" type="xml">
            <form string="LTL shipment">
                <header>
                    <button name="action_open_rate_shop" type="object" string="Get rates"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_parcel_labels" type="object" string="UPS labels"
                            class="oe_highlight" invisible="not parcel_label_id"
                            help="The 4x6 UPS labels, one per box: print them and stick one on each box."/>
                    <button name="action_confirm_booking" type="object" string="Confirm booking"
                            invisible="state != 'draft' or not carrier_id or ltl_parcel"
                            help="Use after booking on the carrier's website or by phone; enter the PRO first."/>
                    <button name="action_assign_pro" type="object" string="Assign PRO"
                            invisible="not can_assign_pro or ltl_parcel"
                            help="Take the next unused PRO from the carrier's pre-assigned block now, to print the BOL and labels before booking. Booking does this by itself."/>
                    <button name="action_print_bol" type="object" string="Print BOL"
                            invisible="state == 'cancel' or ltl_parcel"/>
                    <button name="action_print_labels" type="object" string="Print labels"
                            invisible="state == 'cancel' or ltl_parcel"
                            help="4x6 labels: two per pallet, one per box, numbered 1 of N."/>
                    <button name="action_add_deliveries" type="object" string="Add deliveries"
                            invisible="state not in ('draft', 'booked')"/>
                    <button name="action_mark_picked_up" type="object" string="Picked up"
                            invisible="state != 'booked'"/>
                    <button name="action_mark_delivered" type="object" string="Delivered"
                            invisible="state != 'in_transit'"/>
                    <button name="action_update_tracking" type="object" string="Update tracking"
                            invisible="state not in ('booked', 'in_transit')"/>
                    <button name="action_fetch_documents" type="object" string="Get carrier documents"
                            invisible="state not in ('in_transit', 'delivered') or ltl_parcel"/>
                    <button name="action_open_rate_shop" type="object" string="Re-shop rates"
                            invisible="state != 'booked'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancel', 'delivered')"
                            confirm="Cancel this shipment? A booked pickup is also cancelled with the carrier when its connection can do that; otherwise call the carrier."/>
                    <button name="action_reset_to_draft" type="object" string="Reset to not booked"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,booked,in_transit,delivered"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="not pickup_warning">
                    <strong>Pickup: </strong><field name="pickup_warning" class="d-inline"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="not class_warning">
                    <strong>Class check: </strong><field name="class_warning" class="d-inline"/>
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="bill_status != 'over'">
                    <strong>Billed over quote: </strong>
                    <field name="billed_amount" class="d-inline"/> billed against
                    <field name="quoted_amount" class="d-inline"/> quoted
                    (<field name="variance" class="d-inline"/>).
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button"
                                icon="fa-truck" invisible="not picking_count">
                            <field name="picking_count" widget="statinfo" string="Deliveries"/>
                        </button>
                        <button name="action_view_bills" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="not bill_count">
                            <field name="bill_count" widget="statinfo" string="Carrier bills"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Load">
                            <field name="partner_id" string="Truck delivers to" readonly="state not in ('draft', 'booked')"/>
                            <field name="receiving_hours" invisible="not receiving_hours"/>
                            <field name="consolidated" invisible="1"/>
                            <field name="customer_ids" widget="many2many_tags" invisible="not consolidated"
                                   string="Orders for"/>
                            <field name="shipper_id" readonly="state not in ('draft', 'booked')"/>
                            <field name="is_inbound" invisible="not is_inbound"/>
                            <field name="request_pickup" widget="boolean_toggle" invisible="is_inbound"
                                   readonly="state != 'draft'"/>
                            <label for="ship_date" string="Pickup date" invisible="not request_pickup"/>
                            <label for="ship_date" string="Drop-off date" invisible="request_pickup"/>
                            <field name="ship_date" nolabel="1"/>
                            <label for="pickup_ready_time" string="Pickup window" invisible="not request_pickup"/>
                            <div class="o_row" invisible="not request_pickup">
                                <span>ready</span>
                                <field name="pickup_ready_time" widget="selamta_time_select" class="oe_inline"/>
                                <span class="ms-3">dock closes</span>
                                <field name="pickup_close_time" widget="selamta_time_select" class="oe_inline"/>
                            </div>
                            <field name="order_refs" invisible="not order_refs"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Carrier">
                            <field name="carrier_id" options="{'no_create': True}"
                                   readonly="state not in ('draft', 'booked')"/>
                            <field name="ltl_parcel" invisible="1"/>
                            <field name="parcel_label_id" invisible="1"/>
                            <field name="vendor_id" invisible="ltl_parcel"/>
                            <field name="freight_terms" invisible="ltl_parcel"/>
                            <field name="bill_to_id" invisible="freight_terms != 'third_party' or ltl_parcel"
                                   required="freight_terms == 'third_party' and not ltl_parcel"
                                   context="{'show_address': 1}" options="{'always_reload': True}"/>
                            <field name="parcel_tracking_ref" invisible="not ltl_parcel and not parcel_tracking_ref"/>
                            <field name="parcel_shipment_number" invisible="not parcel_shipment_number"/>
                            <field name="pro_number" invisible="ltl_parcel"/>
                            <field name="pro_preassigned" invisible="not pro_preassigned"/>
                            <field name="can_assign_pro" invisible="1"/>
                            <field name="bol_reference" invisible="ltl_parcel"/>
                            <field name="bol_number" invisible="not bol_number or ltl_parcel"/>
                            <field name="pickup_number" invisible="ltl_parcel"/>
                            <field name="tracking_status" invisible="not tracking_status"/>
                            <field name="delivered_date" invisible="state != 'delivered'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pallets and boxes" name="units">
                            <field name="unit_ids" readonly="state not in ('draft', 'booked')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="quantity"/>
                                    <field name="unit_type"/>
                                    <field name="package_type_id" optional="show" options="{'no_create': True}"/>
                                    <field name="description"/>
                                    <field name="picking_ids" string="Order" widget="many2many_tags" optional="show"
                                           options="{'no_create': True}"
                                           context="{'ltl_show_order': True}"
                                           domain="[('ltl_shipment_id', '=', parent.id)]"/>
                                    <field name="customer_ids" widget="many2many_tags" optional="show"/>
                                    <field name="length"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                    <field name="weight" sum="Total"/>
                                    <field name="cube" sum="Total" optional="show"/>
                                    <field name="density" optional="show"/>
                                    <field name="density_class" optional="show"/>
                                    <field name="class_override" optional="show"/>
                                    <field name="freight_class" decoration-warning="class_note"/>
                                    <field name="nmfc_item" optional="show"/>
                                    <field name="nmfc_sub" optional="hide"/>
                                    <field name="package_id" optional="hide"/>
                                    <field name="class_note" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_units"/>
                                <field name="total_weight"/>
                                <field name="total_cube"/>
                                <field name="density"/>
                            </group>
                        </page>
                        <page string="Services and instructions" name="services">
                            <group>
                                <field name="accessorial_ids" widget="many2many_tags"/>
                                <field name="special_instructions" placeholder="Printed in the Delivery Instructions box, e.g. use back door, call Abel 30 min before"/>
                                <field name="pickup_instructions" placeholder="Printed in the Pickup Instructions box, e.g. freight at dock door 2"/>
                            </group>
                        </page>
                        <page string="Quote" name="quote">
                            <group>
                                <group>
                                    <field name="quoted_amount"/>
                                    <field name="quote_number"/>
                                    <field name="quote_source"/>
                                </group>
                                <group>
                                    <field name="quote_expires"/>
                                    <field name="transit_days"/>
                                </group>
                            </group>
                            <field name="charge_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code" optional="show"/>
                                    <field name="name"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <separator string="Rate shop"/>
                            <p class="text-muted" invisible="rate_ids">
                                Every quote from the rate shop is kept here when a rate is chosen,
                                with the chosen one marked, so the choice can be reviewed later.
                            </p>
                            <div invisible="not rate_ids">
                                <p>
                                    <field name="rate_choice_summary" class="d-inline fw-bold"/>
                                </p>
                                <p class="text-muted">
                                    Chosen on <field name="rates_shopped_on" class="d-inline" readonly="1"/>
                                    by <field name="rates_shopped_by" class="d-inline" readonly="1"
                                              options="{'no_open': True}"/>.
                                </p>
                            </div>
                            <group invisible="not rate_ids">
                                <field name="rate_choice_note"
                                       placeholder="e.g. customer asked for this carrier; the cheaper one has no liftgate"/>
                            </group>
                            <field name="rate_ids" readonly="1" invisible="not rate_ids">
                                <list decoration-success="chosen" decoration-bf="chosen"
                                      decoration-muted="error" decoration-info="parcel and not error and not chosen">
                                    <field name="chosen" widget="boolean_icon" string=" "
                                           options="{'icon': 'fa-check'}" width="30px"/>
                                    <field name="carrier_id"/>
                                    <field name="service"/>
                                    <field name="total" invisible="error"/>
                                    <field name="difference" invisible="error or chosen"/>
                                    <field name="transit_days" invisible="error"/>
                                    <field name="quote_number" optional="show"/>
                                    <field name="expires" optional="hide"/>
                                    <field name="source" optional="hide"/>
                                    <field name="error" optional="show"/>
                                    <field name="parcel" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Carrier bills" name="bills">
                            <group>
                                <group>
                                    <field name="quoted_amount" string="Quoted"/>
                                    <field name="billed_amount"/>
                                </group>
                                <group>
                                    <field name="variance"/>
                                    <field name="variance_percent" widget="float" digits="[16, 1]"/>
                                    <field name="bill_status"/>
                                </group>
                            </group>
                            <field name="bill_ids" options="{'no_create': True}"
                                   context="{'default_move_type': 'in_invoice'}">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="ref"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ltl_shipment_list" model="ir.ui.view">
        <field name="name">selamta.ltl.shipment.list</field>
        <field name="model">selamta.ltl.shipment</field>
        <field name="arch" type="xml">
            <list string="LTL shipments" decoration-muted="state == 'cancel'"
                  decoration-danger="bill_status == 'over'">
                <field name="name"/>
                <field name="ship_date"/>
                <field name="partner_id"/>
                <field name="carrier_id"/>
                <field name="vendor_id" optional="hide"/>
                <field name="pro_number"/>
                <field name="parcel_tracking_ref" optional="hide"/>
                <field name="request_pickup" string="Pickup" optional="hide"/>
                <field name="total_units" optional="show"/>
                <field name="total_weight" optional="show" sum="Total"/>
                <field name="quoted_amount" sum="Total"/>
                <field name="billed_amount" sum="Total"/>
                <field name="variance" sum="Total"/>
                <field name="bill_status" widget="badge"
                       decoration-success="bill_status == 'ok'"
                       decoration-danger="bill_status == 'over'"
                       decoration-info="bill_status == 'under'"
                       decoration-warning="bill_status == 'no_quote'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'booked'"
                       decoration-warning="state == 'in_transit'"
                       decoration-success="state == 'delivered'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_ltl_shipment_search" model="ir.ui.view">
        <field name="name">selamta.ltl.shipment.search</field>
        <field name="model">selamta.ltl.shipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="pro_number"/>
                <field name="parcel_tracking_ref"/>
                <field name="partner_id"/>
                <field name="carrier_id"/>
                <field name="vendor_id"/>
                <filter name="not_booked" string="Not booked" domain="[('state', '=', 'draft')]"/>
                <filter name="open" string="Booked or in transit" domain="[('state', 'in', ('booked', 'in_transit'))]"/>
                <filter name="delivered" string="Delivered" domain="[('state', '=', 'delivered')]"/>
                <filter name="drop_off" string="We drop off" domain="[('request_pickup', '=', False)]"/>
                <separator/>
                <filter name="over" string="Billed over quote" domain="[('bill_status', '=', 'over')]"/>
                <filter name="no_quote" string="Billed, no quote" domain="[('bill_status', '=', 'no_quote')]"/>
                <filter name="not_billed" string="Not billed yet"
                        domain="[('bill_status', '=', 'not_billed'), ('state', 'in', ('in_transit', 'delivered'))]"/>
                <filter name="class_check" string="Class to check" domain="[('class_warning', '!=', False)]"/>
                <separator/>
                <filter name="ship_date" string="Pickup date" date="ship_date"/>
                <group expand="0" string="Group by">
                    <filter name="group_carrier" string="Carrier" context="{'group_by': 'carrier_id'}"/>
                    <filter name="group_vendor" string="Bills come from" context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_bill_status" string="Bill check" context="{'group_by': 'bill_status'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'ship_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ltl_shipment" model="ir.actions.act_window">
        <field name="name">LTL shipments</field>
        <field name="res_model">selamta.ltl.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ltl_shipment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No LTL shipments yet</p>
            <p>Open a delivery order and click <b>LTL shipment</b>. Its pallets and boxes are
               filled in from the packages; measure each one so the class can be worked out.</p>
        </field>
    </record>

    <record id="action_ltl_bill_check" model="ir.actions.act_window">
        <field name="name">LTL bill check</field>
        <field name="res_model">selamta.ltl.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ltl_shipment_search"/>
        <field name="context">{'search_default_over': 1, 'search_default_group_vendor': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No carrier bill over its quote</p>
            <p>Carrier bills are matched to shipments by PRO when they are confirmed, and daily.</p>
        </field>
    </record>
</odoo>
