<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ltl" model="ir.ui.view">
        <field name="name">account.move.form.ltl</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="ltl_vendor" invisible="1"/>
                <button name="action_ltl_match" type="object" string="Match LTL shipment"
                        invisible="not ltl_vendor or ltl_shipment_ids or state == 'cancel'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="LTL freight" name="ltl_freight"
                      invisible="move_type not in ('in_invoice', 'in_refund') or (not ltl_vendor and not ltl_shipment_ids)">
                    <group>
                        <group>
                            <field name="ltl_quoted_amount"/>
                            <field name="ltl_variance" decoration-danger="ltl_variance &gt; 0"/>
                        </group>
                        <group>
                            <field name="ltl_match_note" invisible="not ltl_match_note"/>
                        </group>
                    </group>
                    <field name="ltl_shipment_ids" options="{'no_create': True}">
                        <list>
                            <field name="name"/>
                            <field name="pro_number"/>
                            <field name="partner_id"/>
                            <field name="ship_date"/>
                            <field name="quoted_amount" sum="Total"/>
                            <field name="billed_amount"/>
                            <field name="variance"/>
                            <field name="bill_status"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_server_move_ltl_match" model="ir.actions.server">
        <field name="name">Match LTL shipments</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_ltl_match()</field>
    </record>
</odoo>
