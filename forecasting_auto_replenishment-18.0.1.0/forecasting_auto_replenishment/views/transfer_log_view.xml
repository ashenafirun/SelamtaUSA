<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!-- LOG LIST VIEW -->
        <record id="view_forecast_transfer_log_list" model="ir.ui.view">
            <field name="name">transfer.log.list</field>
            <field name="model">transfer.log</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Transfer Log" create="false">
                    <field name="name" width="20%"/>
                    <field name="rule_id" width="20%"/>
                    <field name="transfer_date" width="20%"/>
                    <field name="total_products" width="20%"/>
                    <field name="total_failed" width="20%"/>
                </list>
            </field>
        </record>

        <!-- LOG FORM VIEW -->
        <record id="view_forecast_transfer_log_form" model="ir.ui.view">
            <field name="name">transfer.log.form</field>
            <field name="model">transfer.log</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Transfer Log" create="false" edit="false">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="rule_id"/>
                                <field name="transfer_date"/>
                            </group>
                            <group>
                                <field name="total_products"/>
                                <field name="total_failed"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Log Lines" name="log_lines">
                                <field name="line_ids" readonly="1">
                                    <list decoration-success="status == 'success'"
                                          decoration-danger="status == 'failed'">
                                        <field name="product_id"/>
                                        <field name="category_id"/>
                                        <field name="status"/>
                                        <field name="reason"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- LOG LINE LIST VIEW -->
        <record id="view_forecast_transfer_log_line_list" model="ir.ui.view">
            <field name="name">transfer.log.line.list</field>
            <field name="model">transfer.log.line</field>
            <field name="arch" type="xml">
                <list string="Transfer Log Line" create="false"
                      decoration-success="status == 'success'"
                      decoration-danger="status == 'failed'">
                    <field name="log_id"/>
                    <field name="product_id"/>
                    <field name="category_id"/>
                    <field name="status"/>
                    <field name="reason"/>
                </list>
            </field>
        </record>

        <!-- LOG LINE FORM VIEW -->
        <record id="view_forecast_transfer_log_line_form" model="ir.ui.view">
            <field name="name">transfer.log.line.form</field>
            <field name="model">transfer.log.line</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Transfer Log Line" create="false" edit="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="log_id"/>
                                <field name="product_id"/>
                                <field name="category_id"/>
                            </group>
                            <group>
                                <field name="status"/>
                                <field name="reason"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- LOG ACTION -->
        <record id="action_forecast_transfer_log" model="ir.actions.act_window">
            <field name="name">Transfer Log</field>
            <field name="res_model">transfer.log</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_forecast_transfer_log_list"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Transfer Logs will display here
                </p>
            </field>
        </record>

        <!-- LOG LINE ACTION -->
        <record id="action_forecast_transfer_log_line" model="ir.actions.act_window">
            <field name="name">Transfer Log Lines</field>
            <field name="res_model">transfer.log.line</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Transfer Log Lines will display here
                </p>
            </field>
        </record>

    </data>

    <data noupdate="1">
        <record id="forecast_transfer_log_sequence" model="ir.sequence">
            <field name="name">Forecast Transfer Log Sequence</field>
            <field name="code">transfer.log</field>
            <field name="padding">5</field>
            <field name="prefix">LOG-</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- MENUS -->
    <menuitem
        id="menu_forecast_transfer_log_root"
        name="Logs"
        parent="forecasting_auto_replenishment.menu_forecast_root"
        sequence="5"/>

    <menuitem
        id="menu_forecast_transfer_log"
        name="Log Book"
        parent="menu_forecast_transfer_log_root"
        sequence="1"
        action="action_forecast_transfer_log"/>

    <menuitem
        id="menu_forecast_transfer_log_line"
        name="Log Book Line"
        parent="menu_forecast_transfer_log_root"
        sequence="2"
        action="action_forecast_transfer_log_line"/>

</odoo>
