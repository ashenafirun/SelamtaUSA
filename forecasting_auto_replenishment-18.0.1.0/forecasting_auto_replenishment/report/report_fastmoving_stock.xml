<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Fast Moving Report PDF -->
        <template id="report_fastmoving_new">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Fast Moving Report</h2>
                        <p style="color:grey; font-size:11px;">
                            Products ranked by movement in the last 30 days — highest demand first.
                        </p>

                        <!-- Summary -->
                        <div style="margin-bottom:12px; font-size:11px; border:1px solid #ddd; padding:8px; border-radius:4px;">
                            <strong>Total Products:</strong> <t t-esc="len(docs)"/>
                            &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;

                            <strong>Fast Moving (Top 20%):</strong>
                            <t t-esc="len(docs.filtered(lambda r: r.status == 'fast'))"/>
                            &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;

                            <strong>Medium Moving:</strong>
                            <t t-esc="len(docs.filtered(lambda r: r.status == 'medium'))"/>
                            &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;

                            <strong>Slow Moving:</strong>
                            <t t-esc="len(docs.filtered(lambda r: r.status == 'slow'))"/>
                        </div>

                        <table class="table table-sm table-bordered" style="font-size:10px;">
                            <thead style="background-color:#f5f5f5;">
                                <tr>
                                    <th>Product</th>
                                    <th>Warehouse</th>
                                    <th class="text-right">Monthly Movement</th>
                                    <th class="text-right">Daily Velocity</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="line">

                                    <!-- Background Color -->
                                    <t t-set="bg" t-value="
                                        '#d4edda' if line.status == 'fast'
                                        else '#d1ecf1' if line.status == 'medium'
                                        else '#f8f9fa'
                                    "/>

                                    <!-- Text Color -->
                                    <t t-set="color" t-value="
                                        'green' if line.status == 'fast'
                                        else '#0c5460' if line.status == 'medium'
                                        else 'grey'
                                    "/>

                                    <!-- Label -->
                                    <t t-set="label" t-value="
                                        'Fast Moving' if line.status == 'fast'
                                        else 'Medium Moving' if line.status == 'medium'
                                        else 'Slow Moving'
                                    "/>

                                    <tr t-attf-style="background-color:{{ bg }};">
                                        <td>
                                            <t t-esc="line.product_id.display_name"/>
                                        </td>
                                        <td>
                                            <t t-esc="line.warehouse_id.display_name"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-esc="line.monthly_movement"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-esc="line.daily_velocity"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-attf-style="color:{{ color }}; font-weight:bold;">
                                                <t t-esc="label"/>
                                            </span>
                                        </td>
                                    </tr>

                                </t>
                            </tbody>
                        </table>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>