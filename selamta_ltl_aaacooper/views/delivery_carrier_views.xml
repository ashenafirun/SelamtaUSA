<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_aaacooper" model="ir.ui.view">
        <field name="name">delivery.carrier.form.aaacooper</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="AAA Cooper" name="aaacooper" invisible="delivery_type != 'aaacooper'">
                    <div class="alert alert-info" role="alert" invisible="aact_book_pickups">
                        Rates and tracking only. Choosing AAA Cooper in the rate shop saves the estimate; request
                        the pickup on aaacooper.com and type the PRO. Turning on "Request pickups through the API"
                        requests real pickups.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not aact_book_pickups">
                        Pickup requests are on: choosing AAA Cooper in the rate shop requests a real pickup.
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="aact_environment" widget="radio"/>
                            <field name="aact_token" password="True" groups="base.group_system"/>
                            <field name="aact_customer_number"/>
                            <field name="aact_pallet_pricing"/>
                            <button name="action_aact_test_connection" type="object" string="Test token (sample rate)"
                                    class="btn-secondary" groups="base.group_system" colspan="2"/>
                        </group>
                        <group string="Booking">
                            <field name="aact_book_pickups"/>
                            <field name="aact_contact_name"/>
                            <field name="aact_contact_phone"/>
                            <field name="aact_contact_email"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_ltl_shipment_form_aaacooper" model="ir.ui.view">
        <field name="name">selamta.ltl.shipment.form.aaacooper</field>
        <field name="model">selamta.ltl.shipment</field>
        <field name="inherit_id" ref="selamta_ltl.view_ltl_shipment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pickup_number']" position="after">
                <field name="aact_terminal" invisible="not aact_terminal"/>
            </xpath>
        </field>
    </record>
</odoo>
