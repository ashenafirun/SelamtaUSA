<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_type_form_inheritance" model="ir.ui.view">
        <field name="name">Operation Types</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence_code']" position="after">
                <field name="packaging_wise_split"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_inheritance" model="ir.ui.view">
        <field name="name">Stock Move Line Custom</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="package_line" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>