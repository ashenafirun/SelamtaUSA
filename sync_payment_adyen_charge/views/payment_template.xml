<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="payment_payment_form_method" inherit_id="payment.method_form">
        <xpath expr="//t[@t-if='is_test']" position="after">
            <!-- <t t-if="mode != 'validation' and provider_sudo.is_support_fees(pm_sudo)">
                <t t-set="fees" t-value="provider_sudo.compute_fees(pm_sudo, amount, currency=currency, partner_id=partner_id)"/>
                <t t-if="fees &gt; 0">
                    <span class="badge rounded-pill text-bg-secondary ms-1">
                        +
                        <t t-esc="fees" t-options="{'widget': 'monetary', 'display_currency': currency}" />
                        Fees
                    </span>
                </t>
            </t> -->

            <t t-if="is_installment and mode != 'validation' and provider_sudo.is_support_fees(pm_sudo) and pm_sudo.code in ['card', 'ach_direct_debit']">

                <t t-set="fees_amount" t-value="fees_amount_card if pm_sudo.code == 'card' else fees_amount_ach"/>
                <t t-set="full_invoice_fee" t-value="full_invoice_fee_card if pm_sudo.code == 'card' else full_invoice_fee_ach"/>

                <div id="fee_wrapper"
                     t-att-data-fees_amount="fees_amount"
                     t-att-data-final_amount="final_amount_with_fee"
                     t-att-data-full_amount="full_invoice_amount"
                     t-att-data-full_fee="full_invoice_fee"
                     t-att-data-amount_custom="amount_custom"
                     t-att-data-is_installment="1 if is_installment else 0">
                    <t t-if="fees_amount">
                        <span class="badge rounded-pill text-bg-secondary ms-1">
                            +
                            <t t-esc="fees_amount" t-options="{'widget': 'monetary', 'display_currency': currency}" />
                            Fees
                        </span>
                    </t>
                </div>
            </t>

            <t t-if="not is_installment and mode != 'validation' and provider_sudo.is_support_fees(pm_sudo)">
                <t t-set="fees" t-value="provider_sudo.compute_fees(pm_sudo, amount, currency=currency, partner_id=partner_id)"/>
                <t t-if="fees > 0">
                    <span class="badge rounded-pill text-bg-secondary ms-1">
                        +
                        <t t-esc="fees" t-options="{'widget': 'monetary', 'display_currency': currency}" />
                        Fees
                    </span>
                </t>
            </t>

        </xpath>
    </template>

    <template id="payment_payment_token_form" inherit_id="payment.token_form">
        <xpath expr="//t[@t-if='is_test']" position="after">
            <div>
                <t t-if="is_installment and mode != 'validation' and token_sudo.provider_id.is_support_fees(token_sudo.payment_method_id)">
                    <!-- <t t-set="fees" t-value="token_sudo.provider_id.compute_fees(token_sudo.payment_method_id, amount, currency=currency, partner_id=partner_id)"/>
                    <t t-if="fees &gt; 0">
                        <span class="badge rounded-pill text-bg-secondary ms-1">
                            +
                            <t t-esc="fees" t-options="{'widget': 'monetary', 'display_currency': currency}" />
                            Fees
                        </span>
                    </t> -->

                    <t t-set="fees_amount" t-value="fees_amount_card"/>
                    <t t-set="full_invoice_fee" t-value="full_invoice_fee_card"/>

                    <div id="fee_wrapper_token"
                         t-att-data-fees_amount="fees_amount"
                         t-att-data-final_amount="final_amount_with_fee"
                         t-att-data-full_amount="full_invoice_amount"
                         t-att-data-full_fee="full_invoice_fee_card"
                         t-att-data-amount_custom="amount_custom"
                         t-att-data-is_installment="1 if is_installment else 0">

                        <t t-if="fees_amount &gt; 0">
                            <span class="badge rounded-pill text-bg-secondary ms-1">
                                +
                                <t t-esc="fees_amount" t-options="{'widget': 'monetary', 'display_currency': currency}" />
                                Fees
                            </span>
                        </t>
                    </div>
                </t>

                <t t-if="not is_installment and mode != 'validation' and token_sudo.provider_id.is_support_fees(token_sudo.payment_method_id)">
                    <t t-set="fees" t-value="token_sudo.provider_id.compute_fees(token_sudo.payment_method_id, amount, currency=currency, partner_id=partner_id)"/>
                    <t t-if="fees > 0">
                        <span class="badge rounded-pill text-bg-secondary ms-1">
                            +
                            <t t-esc="token_sudo.provider_id.compute_fees(token_sudo.payment_method_id, amount, currency=currency, partner_id=partner_id)" t-options="{'widget': 'monetary', 'display_currency': currency}" />
                            Fees
                        </span>
                    </t>
                </t>
            </div>
        </xpath>
    </template>

</odoo>
