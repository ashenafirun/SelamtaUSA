<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_inherit_stripe_charge" model="ir.ui.view">
        <field name="name">Payment Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='messages']" position="before">
                    <page string="Fees" name="fees" invisible="code != 'adyen'">
                        <group col="2" >
                            <field name="main_currency_id" invisible="True"/>
                            <separator string="Credit Card Fees" />
                            <field name="fees_active" />
                            <separator string="Domestic Fees" invisible="not fees_active"/>
                            <field name="fees_dom_fixed" widget="monetary" invisible="not fees_active" />
                            <field name="fees_dom_var" widget="percentage" invisible="not fees_active" />
                            <field name="fees_dom_above" invisible="not fees_active" />
                            <field name="fees_dom_amount" widget="monetary" invisible="not (fees_active and fees_dom_above)" options="{'currency_field': 'main_currency_id'}"/>
                            <separator string="International Fees" invisible="not fees_active"/>
                            <field name="fees_int_fixed" widget="monetary" invisible="not fees_active" />
                            <field name="fees_int_var" widget="percentage" invisible="not fees_active" />
                            <field name="fees_int_above" invisible="not fees_active" />
                            <field name="fees_int_amount" widget="monetary" invisible="not (fees_active and fees_int_above)" options="{'currency_field': 'main_currency_id'}"/>
                        </group>
                  </page>
            </xpath>
        </field>
    </record>
</odoo>
