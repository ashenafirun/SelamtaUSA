    <template id="add_to_cart_main_id" inherit_id="website_sale.product">
      <xpath expr="//form//input[@name='csrf_token']" position="after">
        <input type="hidden" class="wk_input" name="wk_product_page_url"
               t-att-value="'/shop/product/%s' % slug(product)" />
      </xpath>
    </template>

    <template id="add_to_cart_redirect_inherit" inherit_id="website.layout"
              name="Cart Redirection Inherit" priority="2">
      <xpath expr="//html" position="before">
        <t t-set="html_data"
           t-value="dict(html_data, **{'data-shoppage-redirect': '3' if website.add_to_cart_action == 'shop_page' else '0'})" />
      </xpath>
    </template>

    <template id="add_to_cart_icon_id_inherited_" inherit_id="website_sale.products_item">
      <xpath expr="//div[hasclass('product_price')]" position="inside">
<!--        <input type="hidden" class="wk_input" name="wk_products_page_url"-->
<!--               t-att-value="keep('/shop' , page=(pager['page']['num'] if pager['page']['num']&gt;1 else None))" />-->
      </xpath>
      <xpath expr="//div[hasclass('o_wsale_product_information')]" position="inside">
        <t t-set="obj" t-value="request.website.reference_number" />
        <t t-if="obj">
          <t t-if="product.default_code">
            <div>
              <t t-esc="product.default_code" />
            </div>
          </t>
        </t>
      </xpath>
    </template>

