    <template id="checkout_button_inherited_cart" inherit_id="payment.express_checkout"
              name="Checkout Replaced">
      <xpath
              expr="//form"
              position="inside">
        <p class="oe_currency_value wk_cart_values d-none"
           t-att-conf_value="website_sale_order.sudo().get_minimun_cart_value()"
           t-att-currency_symbol="website_sale_order.pricelist_id.currency_id.symbol"
           style="margin:0px;">
          <t t-esc='website_sale_order.sudo().get_minimun_cart_value()'
             t-options='{
                 "widget": "monetary",
                 "display_currency": website.pricelist_id.currency_id
             }' />
        </p>
        <p class="oe_currency_value wk_min_price_value d-none"
           t-att-conf_value="website._get_current_pricelist().minimum_price"
           t-att-currency_symbol="website._get_current_pricelist().currency_id.symbol">
          <t t-esc="website._get_current_pricelist().minimum_price" />
          <t t-esc="website._get_current_pricelist().currency_id.symbol" />
        </p>
        <p class="oe_currency_value wk_min_quant_values d-none"
           t-att-conf_value="website_sale_order.sudo().get_minimum_quantity_value()"
           style="margin:0px;"></p>
        <p class="oe_currency_value wk_max_quant_values d-none"
           t-att-conf_value="website_sale_order.sudo().get_max_quantity_value()" style="margin:0px;"></p>
        <p class="is_amount_valid d-none" t-att-is_amount_valid="is_amount_valid"
           style="margin:0px;"></p>

      </xpath>
    </template>

    <template id="shop_product_cart_update" inherit_id="website_sale.product_price"
              name="Shop Product Cart Update">
      <xpath expr="//span[hasclass('oe_price')]" position="after">
        <span t-if="website.show_subTotal()" id="sub_total" class="total-sum ml8"
              t-esc="combination_info['price']" style="white-space: nowrap;"
              t-options="{'widget': 'monetary','display_currency': website.currency_id}" />
      </xpath>
    </template>

    <template id="product_inherit" inherit_id="website_sale.product">
      <xpath expr="//div[@id='add_to_cart_wrap']" position="inside">
        <t t-set="id" t-value="product.id"></t>
        <!-- <span t-att-value='product_variant' t-esc="product_variant"/> -->
        <p class="d-none" id="max_min_values"
           t-att-min_quantity="product.minimum_product_quantity"
           t-att-max_quantity="product.max_product_quantity"
        ></p>
      </xpath>
    </template>
    <template id="products_template" inherit_id="website_sale.product">
      <xpath expr="//div[hasclass('js_main_product')]" position="before">
        <t t-set="obj" t-value="request.website.reference_number" />
        <t t-if="obj">
          <t t-if="product_variant.default_code">
            <div class="code" id="msg_div">
              <t t-esc="product_variant.default_code" />
            </div>
          </t>
        </t>
      </xpath>
    </template>
  </data>
