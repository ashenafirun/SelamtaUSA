<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_rlcarriers" model="ir.ui.view">
        <field name="name">delivery.carrier.form.rlcarriers</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="R+L" name="rlcarriers" invisible="delivery_type != 'rlcarriers'">
                    <div class="alert alert-info" role="alert" invisible="rlc_book_shipments">
                        Rates and tracking only. Choosing R+L in the rate shop saves the quote; book on
                        rlcarriers.com and type the PRO. Turning on "Create BOLs through the API" creates real
                        R+L BOLs and pickups.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not rlc_book_shipments or rlc_environment != 'production'">
                        BOLs are on: choosing R+L in the rate shop creates a real R+L BOL and PRO
                        <span invisible="not rlc_schedule_pickup">and schedules the pickup</span>.
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="rlc_environment" widget="radio"/>
                            <field name="rlc_api_key" password="True" groups="base.group_system"/>
                            <field name="rlc_show_guaranteed"/>
                            <button name="action_rlc_test_connection" type="object" string="Test API key (sample rate)"
                                    class="btn-secondary" groups="base.group_system" colspan="2"/>
                        </group>
                        <group string="Booking">
                            <field name="rlc_book_shipments"/>
                            <field name="rlc_schedule_pickup"/>
                            <field name="rlc_universal_pro"/>
                            <field name="rlc_food_load"/>
                            <field name="rlc_contact_name"/>
                            <field name="rlc_contact_phone"/>
                            <field name="rlc_contact_email"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_ltl_shipment_form_rlcarriers" model="ir.ui.view">
        <field name="name">selamta.ltl.shipment.form.rlcarriers</field>
        <field name="model">selamta.ltl.shipment</field>
        <field name="inherit_id" ref="selamta_ltl.view_ltl_shipment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pickup_number']" position="after">
                <field name="rlc_service_center" invisible="not rlc_service_center"/>
            </xpath>
        </field>
    </record>
</odoo>
